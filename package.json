{
  "name": "portfolio-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "seed:pages": "tsx --env-file=.env.local scripts/seed-pages.ts",
    "verify:neon:db": "tsx --env-file=.env.local scripts/verify-neon-db.ts",
    "verify:neon:auth": "bash scripts/verify-neon-auth.sh",
    "verify:neon": "bash scripts/verify-neon.sh",
    "verify:phase9": "tsx --env-file=.env.local scripts/verify-phase9.ts",
    "verify:phase10:preflight": "tsx scripts/verify-phase10-preflight.ts",
    "verify:phase10:config": "tsx --env-file=.env.local scripts/verify-phase10-vercel-config.ts",
    "verify:phase10:production": "tsx scripts/verify-phase10-production.ts",
    "verify:phase10:r2-e2e": "tsx --conditions=react-server --env-file=.env.local scripts/verify-phase10-r2-e2e.ts",
    "verify:phase10": "tsx --env-file=.env.local scripts/verify-phase10.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.2",
    "image-size": "^2.0.2",
    "lenis": "^1.3.26",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "wrangler": "^4.86.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
