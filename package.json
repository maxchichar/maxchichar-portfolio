{
  "name": "portfolio-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "generate:social-preview": "tsx scripts/generate-social-preview.tsx",
    "verify:social-preview": "tsx scripts/verify-social-preview.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --conditions=react-server --test \"scripts/test-*.ts\"",
    "test:e2e": "playwright test -c e2e",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "seed:pages": "tsx --env-file=.env.local scripts/seed-pages.ts",
    "verify:neon:db": "tsx --env-file=.env.local scripts/verify-neon-db.ts",
    "verify:neon:auth": "bash scripts/verify-neon-auth.sh",
    "verify:neon": "bash scripts/verify-neon.sh",
    "verify:phase9": "tsx --env-file=.env.local scripts/verify-phase9.ts",
    "verify:phase10:preflight": "tsx scripts/verify-phase10-preflight.ts",
    "verify:phase10:config": "tsx --env-file=.env.local scripts/verify-phase10-vercel-config.ts",
    "verify:phase10:production": "tsx scripts/verify-phase10-production.ts",
    "verify:phase10:r2-e2e": "tsx --conditions=react-server --env-file=.env.local scripts/verify-phase10-r2-e2e.ts",
    "verify:phase10": "tsx --env-file=.env.local scripts/verify-phase10.ts",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .cloudflare-dry-run",
    "setup:admin": "tsx scripts/setup-admin.ts",
    "deploy:edge": "wrangler deploy --config wrangler.edge.jsonc",
    "check:edge": "wrangler deploy --config wrangler.edge.jsonc --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@neondatabase/serverless": "^1.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.2.0",
    "image-size": "^2.0.4",
    "lenis": "^1.3.27",
    "marked": "18.1.1",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "4.152.0",
    "@opennextjs/cloudflare": "1.20.13"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false,
    "workerd": true
  }
}
