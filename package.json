{
  "name": "portfolio-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --conditions=react-server --test \"scripts/test-*.ts\"",
    "test:e2e": "playwright test -c e2e",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "seed:pages": "tsx --env-file=.env.local scripts/seed-pages.ts",
    "verify:neon:db": "tsx --env-file=.env.local scripts/verify-neon-db.ts",
    "verify:neon:auth": "bash scripts/verify-neon-auth.sh",
    "verify:neon": "bash scripts/verify-neon.sh",
    "verify:phase9": "tsx --env-file=.env.local scripts/verify-phase9.ts",
    "verify:phase10:preflight": "tsx scripts/verify-phase10-preflight.ts",
    "verify:phase10:config": "tsx --env-file=.env.local scripts/verify-phase10-vercel-config.ts",
    "verify:phase10:production": "tsx scripts/verify-phase10-production.ts",
    "verify:phase10:r2-e2e": "tsx --conditions=react-server --env-file=.env.local scripts/verify-phase10-r2-e2e.ts",
    "verify:phase10": "tsx --env-file=.env.local scripts/verify-phase10.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@neondatabase/serverless": "^1.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.1.1",
    "image-size": "^2.0.4",
    "lenis": "^1.3.26",
    "marked": "18.0.14",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false
  }
}
