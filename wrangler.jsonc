{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maxchichar-portfolio",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "ADMIN_ORIGIN": "https://admin.chibuezemaxwell.com",
    "SITE_URL": "https://chibuezemaxwell.com",
    "NEXT_PUBLIC_SITE_URL": "https://chibuezemaxwell.com",
    "STORAGE_PUBLIC_URL": "https://pub-be5b26d4fdc14d42a7bfa1843c84c207.r2.dev",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFUGnPMVpoAs1uxW",
  },
  "workers_dev": true,
  "preview_urls": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "maxchichar-portfolio" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
