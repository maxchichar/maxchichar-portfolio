# Portfolio OS — environment variables contract
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# =============================================================================
# REQUIRED IN PRODUCTION
# =============================================================================

# Postgres connection string (Neon with connection pooling) — server-only
DATABASE_URL=

# Auth.js v5 session encryption secret (32+ char random string or base64) — server-only
AUTH_SECRET=

# Cloudflare R2 (S3-compatible) object storage credentials — server-only
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# =============================================================================
# OPTIONAL / ENVIRONMENT-SPECIFIC
# =============================================================================

# Required for media delivery: public R2 domain (e.g., https://pub-<hash>.r2.dev or custom media domain)
# Never use the private *.r2.cloudflarestorage.com API endpoint here.
STORAGE_PUBLIC_URL=

# Base public site URL for metadataBase, sitemap, OpenGraph, and canonicals
# In Vercel production, falls back automatically to VERCEL_PROJECT_PRODUCTION_URL.
# Set explicitly if using a custom apex/www domain (e.g., https://maxchichar.com).
NEXT_PUBLIC_SITE_URL=https://chibuezemaxwell.com

# Alternative fallback for NEXT_PUBLIC_SITE_URL (server-only)
SITE_URL=

# Only needed when running `next start` on a standalone host or custom proxy.
# On Vercel, host headers are trusted automatically — leave unset on Vercel.
AUTH_TRUST_HOST=

# One-time admin seed script (npm run seed:admin) — server-only, not needed in production runtime
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Privacy-conscious analytics ID — readiness only
ANALYTICS_ID=

# Contact form email (optional). Without RESEND_API_KEY messages still land in
# the admin inbox; no email is sent.
# API key from https://resend.com (free tier) — server-only
RESEND_API_KEY=
# Where new-message alerts go. Defaults to the Primary email in admin Settings.
# With the shared test sender this must be the address you signed up to Resend with.
CONTACT_NOTIFY_EMAIL=
# Sender on a domain you verified in Resend, e.g. "Chibueze Maxwell <hello@yourdomain.com>".
# Leave empty to use Resend's test sender (alerts to you only). Setting it also
# turns on the thank-you receipt to visitors; set CONTACT_AUTO_REPLY=false to disable that.
CONTACT_FROM_EMAIL=
CONTACT_AUTO_REPLY=

# Cloudflare Turnstile "are you human" check on the contact form (optional).
# Create a widget at dash.cloudflare.com > Turnstile, add your domain(s).
# Both keys are required; with either missing the check is off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# server-only
TURNSTILE_SECRET_KEY=

# Error alerts (optional). Production errors are emailed through Resend
# (RESEND_API_KEY above), grouped, at most once per error every 6 hours.
# Defaults to CONTACT_NOTIFY_EMAIL, then the Primary email in Settings.
ERROR_ALERT_EMAIL=
